# Copy to .env and fill in your Gemini key. Do not commit .env.
GEMINI_API_KEY=

# Optional: model names
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SCREEN_MODEL=gemini-2.5-flash

# Optional: enable screenshot-based focus classification in the backend.
# The probe can also enable this with: python scripts/activity_probe.py --screen-ai
TERPPET_SCREEN_AI=0
TERPPET_SCREEN_AI_INTERVAL_SECONDS=10
